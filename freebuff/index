<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0b1115">
  <title>LoRa GPS Link Simulator</title>
  <style>
    :root{color-scheme:dark;--bg:#0b1115;--panel:#111a1f;--panel2:#0e171b;--line:#25343a;--muted:#84969b;--text:#ecf4f1;--mint:#a5f3c4;--mint2:#55d990;--blue:#91c9ff;--amber:#f6c779;--red:#ff8e82;font:14px/1.5 ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif}
    *{box-sizing:border-box}body{margin:0;min-height:100vh;background:radial-gradient(ellipse at 52% -18%,#1c3432 0,transparent 42%),var(--bg);color:var(--text)}button,input{font:inherit}button{cursor:pointer}.shell{width:min(1160px,calc(100% - 40px));margin:auto;padding:32px 0 28px}.topbar{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:34px}.brand{display:flex;align-items:center;gap:12px}.brand-icon{width:38px;height:38px;border:1px solid #42645a;border-radius:12px;display:grid;place-items:center;color:var(--mint);background:#132720}.brand-icon svg{width:21px}.brand-title{font-weight:750;letter-spacing:.02em}.brand-sub{font-size:11px;color:var(--muted);letter-spacing:.13em;text-transform:uppercase}.mode{border:1px solid #345044;background:#13241c;color:var(--mint);border-radius:99px;padding:7px 11px;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;display:flex;align-items:center;gap:8px}.dot{width:7px;height:7px;background:var(--mint2);border-radius:50%;box-shadow:0 0 12px #55d990}.intro{display:flex;justify-content:space-between;align-items:end;gap:18px;margin-bottom:24px}.eyebrow{font-size:11px;color:var(--mint);font-weight:700;letter-spacing:.16em;text-transform:uppercase}.intro h1{font-size:clamp(27px,4vw,39px);line-height:1.13;letter-spacing:-.045em;margin:8px 0 7px}.intro p{color:var(--muted);margin:0;max-width:570px}.frequency{display:flex;gap:8px;align-items:center;color:var(--muted);font-size:12px;white-space:nowrap;padding-bottom:4px}.frequency strong{color:#dce9e4;font-weight:600}.grid{display:grid;grid-template-columns:minmax(0,1fr) 175px minmax(0,1fr);align-items:stretch;gap:16px}.device,.link-panel,.activity{border:1px solid var(--line);background:linear-gradient(155deg,rgba(21,31,36,.98),rgba(14,22,26,.98));border-radius:16px;box-shadow:0 16px 48px #0002}.device{padding:19px;min-width:0}.device-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}.device-ident{display:flex;align-items:center;gap:11px}.device-icon{width:37px;height:37px;border-radius:11px;display:grid;place-items:center;background:#1b3029;color:var(--mint)}.receiver .device-icon{color:var(--blue);background:#1a2a36}.device-icon svg{width:20px;height:20px}.kicker{font-size:10px;color:var(--muted);letter-spacing:.13em;text-transform:uppercase}.device-name{font-size:15px;font-weight:700}.online{display:flex;align-items:center;gap:6px;color:var(--mint);font-size:11px}.online .dot{width:6px;height:6px}.receiver .online{color:var(--blue)}.receiver .online .dot{background:var(--blue);box-shadow:0 0 10px var(--blue)}.screen{border:1px solid #28363a;border-radius:11px;background:#09110f;padding:15px;margin-bottom:14px;position:relative;overflow:hidden}.screen:before{content:"";position:absolute;inset:0;opacity:.13;pointer-events:none;background:repeating-linear-gradient(0deg,transparent,transparent 3px,#8fffb2 4px)}.screen-top{display:flex;justify-content:space-between;position:relative;color:#749187;font-size:10px;letter-spacing:.1em;text-transform:uppercase}.gps-fix{color:var(--mint);display:flex;gap:5px;align-items:center}.coordinates{position:relative;margin-top:13px;display:grid;grid-template-columns:1fr 1fr;gap:10px}.coord-label{display:block;color:#71857d;font-size:10px;text-transform:uppercase;letter-spacing:.12em;margin-bottom:3px}.coord-input{width:100%;background:transparent;border:0;border-bottom:1px solid #263b32;padding:2px 0 5px;color:#c8f8d6;font-size:17px;font-weight:650;font-variant-numeric:tabular-nums;outline:none}.coord-input:focus{border-color:var(--mint)}.message-label,.rx-label{display:block;color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.1em;margin:15px 0 7px}.message-input{width:100%;height:42px;border:1px solid #2b3a3e;border-radius:8px;background:#0c1417;padding:0 11px;color:var(--text);outline:none}.message-input:focus{border-color:#6cc996}.move-button{border:0;background:transparent;padding:0;color:var(--mint);font-size:11px;font-weight:650}.move-button:hover{text-decoration:underline}.send-button{width:100%;border:1px solid #8ce8ad;border-radius:9px;padding:10px;background:linear-gradient(115deg,#b6f5cc,#73dfa0);color:#102118;font-weight:750;display:flex;justify-content:center;align-items:center;gap:9px;transition:transform .15s,filter .15s}.send-button:hover{filter:brightness(1.06);transform:translateY(-1px)}.send-button:active{transform:translateY(0)}.send-button svg{width:16px}.sos-button{width:100%;margin-top:9px;border:1px solid #87453f;border-radius:9px;padding:10px;background:linear-gradient(115deg,#ffaaa0,#f47c70);color:#351410;font-weight:800;letter-spacing:.06em;display:flex;justify-content:center;align-items:center;gap:8px;transition:filter .15s,transform .15s}.sos-button:hover{filter:brightness(1.08);transform:translateY(-1px)}.sos-button:disabled{opacity:.7;cursor:wait}.sos-mark{width:18px;height:18px;border:2px solid currentColor;border-radius:50%;display:grid;place-items:center;font-size:11px;line-height:1}.boat-input{width:100%;height:38px;border:1px solid #2b3a3e;border-radius:8px;background:#0c1417;padding:0 11px;color:var(--text);outline:none}.boat-input:focus{border-color:#6cc996}.link-panel{display:flex;flex-direction:column;align-items:center;justify-content:center;position:relative;overflow:hidden;padding:14px 9px}.link-label{font-size:10px;text-transform:uppercase;letter-spacing:.15em;color:var(--muted);text-align:center}.radio-stage{width:100%;height:123px;position:relative;display:flex;align-items:center;justify-content:center}.radio-core{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;color:var(--mint);background:#193126;border:1px solid #41604f;z-index:1}.radio-core svg{width:20px}.wave{position:absolute;border:1px solid #3b6451;border-radius:50%;width:62px;height:62px;opacity:.22}.wave.w2{width:90px;height:90px;opacity:.15}.wave.w3{width:120px;height:120px;opacity:.1}.radio-stage.transmitting .wave{animation:pulse 1s ease-out infinite}.radio-stage.transmitting .w2{animation-delay:.18s}.radio-stage.transmitting .w3{animation-delay:.36s}@keyframes pulse{0%{transform:scale(.7);opacity:.5}100%{transform:scale(1.12);opacity:0}}.beam{position:absolute;top:50%;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,#527d65,transparent);opacity:.65}.link-spec{text-align:center;font-size:11px;color:#d0dfd8;line-height:1.9}.link-spec span{display:block;font-size:10px;color:var(--muted)}.packet-count{margin-top:12px;padding:6px 10px;border:1px solid #2a393b;background:#101a1d;border-radius:99px;color:#a5b8ae;font-size:10px}.receiver-screen{min-height:164px;border:1px solid #28363a;border-radius:11px;background:#091118;padding:14px;position:relative;overflow:hidden}.receiver-screen:before{content:"";position:absolute;inset:0;opacity:.09;background-image:linear-gradient(#7ac9ff 1px,transparent 1px),linear-gradient(90deg,#7ac9ff 1px,transparent 1px);background-size:19px 19px}.rx-empty,.rx-data{position:relative;z-index:1}.rx-empty{height:100%;display:flex;flex-direction:column;justify-content:center;align-items:center;color:#73848a;text-align:center;font-size:12px}.rx-empty svg{width:23px;margin-bottom:8px;opacity:.7}.rx-data{display:none}.rx-emergency{display:none;width:max-content;margin-bottom:7px;border:1px solid #87453f;border-radius:99px;padding:2px 7px;color:#ffaaa0;background:#351c1a;font-size:9px;font-weight:800;letter-spacing:.1em}.rx-data.is-emergency .rx-emergency{display:block}.rx-detail{display:flex;justify-content:space-between;gap:8px;color:#849ba4;font-size:10px;margin-top:7px}.rx-coordinate{font-size:17px;font-weight:700;color:#b9ddff;font-variant-numeric:tabular-nums;letter-spacing:-.025em}.rx-message{color:#e9f4f8;margin-top:8px;overflow-wrap:anywhere}.rx-time{display:flex;justify-content:space-between;gap:8px;margin-top:8px;color:#768d97;font-size:10px}.receiver.ping .receiver-screen{animation:received .65s ease-out}@keyframes received{0%{border-color:#a6dcff;box-shadow:0 0 22px #69baff38}100%{border-color:#28363a;box-shadow:none}}.rx-meta{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:13px}.meta-box{border:1px solid #27353a;border-radius:8px;padding:9px 10px;background:#111a1f}.meta-title{font-size:9px;color:var(--muted);letter-spacing:.1em;text-transform:uppercase}.meta-value{font-size:12px;color:#d6e5e8;margin-top:3px;font-variant-numeric:tabular-nums}.activity{margin-top:16px;padding:17px 19px}.activity-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}.activity-title{font-size:13px;font-weight:700}.clear-button{border:0;background:none;color:var(--muted);font-size:11px}.clear-button:hover{color:var(--text)}.log{display:flex;align-items:center;gap:11px;min-height:49px;border-top:1px solid #243137;color:#c8d5d4;font-size:12px}.log:first-child{border-top:0}.log-icon{width:25px;height:25px;border-radius:8px;display:grid;place-items:center;background:#18271f;color:var(--mint);flex:none}.log-icon svg{width:13px}.log-text{min-width:0;flex:1}.log-text strong{font-weight:650}.log-detail{display:block;color:var(--muted);font-size:10px;margin-top:1px;overflow-wrap:anywhere}.log-time{color:#829196;font-size:10px;white-space:nowrap}.empty-log{color:var(--muted);font-size:12px;padding:11px 0 3px}.footnote{display:flex;justify-content:space-between;gap:15px;margin-top:14px;color:#6e7e82;font-size:10px}.footnote strong{color:#9caeaa;font-weight:600}.toast{position:fixed;bottom:20px;left:50%;transform:translate(-50%,15px);padding:9px 14px;border:1px solid #42614e;border-radius:9px;background:#15231b;color:var(--mint);font-size:12px;opacity:0;transition:.2s;pointer-events:none}.toast.show{opacity:1;transform:translate(-50%,0)}
    @media(max-width:820px){.grid{grid-template-columns:1fr 118px 1fr;gap:10px}.device{padding:14px}.link-panel{padding:10px 5px}.radio-stage{height:105px}.wave.w3{width:100px;height:100px}.frequency{display:none}.coord-input{font-size:14px}.rx-coordinate{font-size:14px}}
    @media(max-width:620px){.shell{width:min(100% - 28px,460px);padding-top:20px}.topbar{margin-bottom:26px}.intro{align-items:start}.intro p{font-size:13px}.grid{grid-template-columns:1fr;gap:11px}.link-panel{height:106px;display:grid;grid-template-columns:1fr 110px 1fr;gap:5px;padding:8px 14px}.link-label{text-align:right}.radio-stage{height:80px}.wave.w3{width:75px;height:75px}.wave.w2{width:57px;height:57px}.wave{width:40px;height:40px}.link-spec{text-align:left}.link-spec span{display:none}.packet-count{display:none}.beam{left:8px;right:8px}.device-head{margin-bottom:15px}.footnote{flex-direction:column;gap:4px}.activity{padding:15px}}
  </style>
</head>
<body>
  <main class="shell">
    <header class="topbar">
      <div class="brand">
        <div class="brand-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 16v5m-4 0h8M8.5 12.5a5 5 0 0 1 7 0M5 9a10 10 0 0 1 14 0M1.8 5.8a14.5 14.5 0 0 1 20.4 0"/><circle cx="12" cy="18" r="1" fill="currentColor"/></svg></div>
        <div><div class="brand-title">FIELDLINK</div><div class="brand-sub">LoRa GPS lab</div></div>
      </div>
      <div class="mode"><span class="dot"></span>Simulation running</div>
    </header>

    <section class="intro">
      <div><div class="eyebrow">Point-to-point telemetry</div><h1>LoRa GPS link simulator</h1><p>Send a GPS fix and a short message from one Heltec board to another, just like your planned field setup.</p></div>
      <div class="frequency"><span>RADIO BAND</span><strong>915 MHz · SF7 · 125 kHz</strong></div>
    </section>

    <section class="grid" aria-label="LoRa GPS simulation">
      <article class="device transmitter">
        <div class="device-head"><div class="device-ident"><div class="device-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 16v5m-4 0h8M8.5 12.5a5 5 0 0 1 7 0M5 9a10 10 0 0 1 14 0M1.8 5.8a14.5 14.5 0 0 1 20.4 0"/><circle cx="12" cy="18" r="1" fill="currentColor"/></svg></div><div><div class="kicker">Node 01</div><div class="device-name">GPS Transmitter</div></div></div><div class="online"><span class="dot"></span>ONLINE</div></div>
        <div class="screen">
          <div class="screen-top"><span>NEO-6M · GPS</span><span class="gps-fix"><span class="dot"></span>3D FIX</span></div>
          <div class="coordinates">
            <label><span class="coord-label">Latitude</span><input class="coord-input" id="latitude" inputmode="decimal" aria-label="Latitude" value="37.7749"></label>
            <label><span class="coord-label">Longitude</span><input class="coord-input" id="longitude" inputmode="decimal" aria-label="Longitude" value="-122.4194"></label>
          </div>
        </div>
        <button class="move-button" id="moveButton" type="button">↗ Simulate GPS movement</button>
        <label class="message-label" for="boatId">Boat ID</label>
        <input class="boat-input" id="boatId" maxlength="20" value="BOAT-01" placeholder="Enter boat ID">
        <label class="message-label" for="message">Message payload</label>
        <input class="message-input" id="message" maxlength="80" value="Hello from the trail!" placeholder="Type a short message…">
        <div style="height:12px"></div>
        <button class="send-button" id="sendButton" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m22 2-7 20-4-9-9-4 20-7ZM22 2 11 13"/></svg>Transmit packet</button>
        <button class="sos-button" id="sosButton" type="button"><span class="sos-mark">!</span>SEND SOS EMERGENCY</button>
      </article>

      <div class="link-panel" aria-label="LoRa radio link">
        <div class="link-label">LoRa radio link</div>
        <div class="radio-stage" id="radioStage"><div class="beam"></div><div class="wave w3"></div><div class="wave w2"></div><div class="wave"></div><div class="radio-core"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 16v5m-4 0h8M8.5 12.5a5 5 0 0 1 7 0M5 9a10 10 0 0 1 14 0M1.8 5.8a14.5 14.5 0 0 1 20.4 0"/><circle cx="12" cy="18" r="1" fill="currentColor"/></svg></div></div>
        <div class="link-spec"><strong>915 MHz</strong><span>SF7 · BW 125 kHz</span></div>
        <div class="packet-count"><span id="packetCount">0</span> packets received</div>
      </div>

      <article class="device receiver" id="receiverCard">
        <div class="device-head"><div class="device-ident"><div class="device-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M8 7h8M8 11h8M8 15h4m-3 3h6"/></svg></div><div><div class="kicker">Node 02</div><div class="device-name">LoRa Receiver</div></div></div><div class="online"><span class="dot"></span>LISTENING</div></div>
        <div class="receiver-screen">
          <div class="rx-empty" id="rxEmpty"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 16v5m-4 0h8M8.5 12.5a5 5 0 0 1 7 0M5 9a10 10 0 0 1 14 0M1.8 5.8a14.5 14.5 0 0 1 20.4 0"/><circle cx="12" cy="18" r="1" fill="currentColor"/></svg>Waiting for first packet</div>
          <div class="rx-data" id="rxData"><div class="rx-emergency" id="rxEmergency">SOS · EMERGENCY</div><div class="rx-label" style="margin:0 0 5px">GPS LOCATION</div><div class="rx-coordinate" id="rxCoordinates">—</div><div class="rx-message" id="rxMessage">—</div><div class="rx-detail"><span>BOAT ID</span><strong id="rxBoatId">—</strong></div><div class="rx-detail"><span>TIME RECEIVED</span><strong id="rxTime">—</strong></div></div>
        </div>
        <div class="rx-meta"><div class="meta-box"><div class="meta-title">Signal (RSSI)</div><div class="meta-value" id="rssi">— dBm</div></div><div class="meta-box"><div class="meta-title">Sequence</div><div class="meta-value" id="sequence">—</div></div></div>
      </article>
    </section>

    <section class="activity">
      <div class="activity-head"><div class="activity-title">Packet activity</div><button class="clear-button" id="clearButton" type="button">Clear log</button></div>
      <div id="activityLog"><div class="empty-log" id="emptyLog">No packets yet. Transmit a message to see it arrive here.</div></div>
    </section>
    <footer class="footnote"><span><strong>Simulation only</strong> · No physical LoRa hardware is connected.</span><span>For real use, select the legal frequency band for your region.</span></footer>
  </main>
  <div class="toast" id="toast" role="status" aria-live="polite"></div>
  <script>
    (()=>{
      const $=id=>document.getElementById(id);
      let packets=0, moveStep=0, toastTimer, sending=false;
      const coords=()=>({lat:Number($("latitude").value),lon:Number($("longitude").value)});
      function showToast(text){const t=$("toast");t.textContent=text;t.classList.add("show");clearTimeout(toastTimer);toastTimer=setTimeout(()=>t.classList.remove("show"),2100)}
      function addLog(sequence,lat,lon,message,time,rssi,boatId,isSos){ 
        const empty=$("emptyLog");if(empty)empty.remove();
        const row=document.createElement("div");row.className="log";
        const icon=document.createElement("div");icon.className="log-icon";icon.textContent="↗";
        const body=document.createElement("div");body.className="log-text";
        const title=document.createElement("strong");title.textContent=isSos?`SOS EMERGENCY · ${boatId}`:`Packet #${sequence} received`;
        const detail=document.createElement("span");detail.className="log-detail";detail.textContent=`${lat.toFixed(5)}, ${lon.toFixed(5)} · ${boatId} · ${message} · ${time} · ${rssi} dBm`;
        if(isSos){icon.textContent="!";icon.style.color="#ffaaa0";icon.style.background="#351c1a";row.style.borderLeft="2px solid #f47c70";row.style.paddingLeft="9px";}
        const stamp=document.createElement("span");stamp.className="log-time";stamp.textContent=time;
        body.append(title,detail);row.append(icon,body,stamp);$("activityLog").prepend(row);
      }
      function transmit(isSos=false){
        if(sending)return;
        const {lat,lon}=coords(),boatId=$("boatId").value.trim();
        const message=isSos?"EMERGENCY":$("message").value.trim();
        if(!Number.isFinite(lat)||lat < -90||lat > 90||!Number.isFinite(lon)||lon < -180||lon > 180){showToast("Enter valid latitude and longitude.");return}
        if(!boatId){showToast("Enter a boat ID before transmitting.");$("boatId").focus();return}
        if(!message){showToast("Add a message before transmitting.");$("message").focus();return}
        sending=true;const buttons=[$("sendButton"),$("sosButton")],stage=$("radioStage");buttons.forEach(button=>button.disabled=true);stage.classList.add("transmitting");
        const current=++packets,date=new Date(),stamp=date.toLocaleString([], {year:"numeric",month:"short",day:"2-digit",hour:"2-digit",minute:"2-digit",second:"2-digit"}),signal=-70-Math.floor(Math.random()*19);
        showToast(isSos?"SOS emergency transmitting…":"Packet transmitting…");
        setTimeout(()=>{
          $("rxEmpty").style.display="none";$("rxData").style.display="block";
          $("rxData").classList.toggle("is-emergency",isSos);
          $("rxCoordinates").textContent=`${lat.toFixed(5)}°, ${lon.toFixed(5)}°`;
          $("rxMessage").textContent=message;$("rxBoatId").textContent=boatId;$("rxTime").textContent=stamp;
          $("rssi").textContent=`${signal} dBm`;$("sequence").textContent=String(current).padStart(3,"0");$("packetCount").textContent=current;
          const card=$("receiverCard");card.classList.remove("ping");void card.offsetWidth;card.classList.add("ping");
          addLog(current,lat,lon,message,stamp,signal,boatId,isSos);stage.classList.remove("transmitting");sending=false;buttons.forEach(button=>button.disabled=false);showToast(isSos?`SOS from ${boatId} delivered to receiver.`:`Packet #${current} delivered to receiver.`);
        },850);
      }
      $("sendButton").addEventListener("click",()=>transmit(false));
      $("sosButton").addEventListener("click",()=>transmit(true));
      $("message").addEventListener("keydown",e=>{if(e.key==="Enter")transmit(false)});
      $("moveButton").addEventListener("click",()=>{
        moveStep++;const base=coords();
        const lat=base.lat+0.00035,lon=base.lon+0.00052;
        $("latitude").value=lat.toFixed(5);$("longitude").value=lon.toFixed(5);
        showToast(`GPS fix updated · movement ${moveStep}`);
      });
      $("clearButton").addEventListener("click",()=>{
        $("activityLog").replaceChildren();const empty=document.createElement("div");empty.className="empty-log";empty.id="emptyLog";empty.textContent="Activity log cleared. New packets will appear here.";$("activityLog").append(empty);
      });
    })();
  </script>
</body>
</html>
