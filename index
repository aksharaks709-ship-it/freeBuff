{display:block;color:#d9e8e2;font-size:11px;margin-top:3px}.mission-stat.alert strong{color:var(--amber)}.survivor-status{grid-column:1/-1;border:1px solid #35443d;background:#121e19;border-radius:8px;padding:9px;color:#b2c2b8;font-size:9px;min-height:38px}.map-legend{grid-column:1/-1;display:flex;flex-wrap:wrap;gap:9px;color:var(--muted);font-size:8px}.legend-key{display:inline-flex;gap:4px;align-items:center}.legend-swatch{width:9px;height:9px;border-radius:3px;background:#303b3b}.legend-swatch.water{background:#17434a}.legend-swatch.heat{background:#ff8977}.legend-swatch.boatkey{background:#70d49a}.mission-disclaimer{grid-column:1/-1;color:#778987;font-size:8px}.rescue-button{grid-column:1/-1;border:1px solid #4a805c;border-radius:7px;background:#163323;color:#b7efc8;padding:7px;font-size:9px;font-weight:750}.rescue-button[hidden]{display:none}.rescue-found{border-color:#8b5745;background:#2c211b}.thermal-toggle input:checked~span{color:#b7efca}.mission-remote{grid-column:1/-1;margin-top:4px}.mission-remote .remote-grid{gap:4px}.mission-remote .remote-btn{padding:6px 3px;font-size:8px}@media(max-width:650px){.mission-layout{grid-template-columns:1fr}.house-map{grid-template-rows:repeat(7,32px)}.mission-stats{grid-template-columns:1fr 1fr}}
  </style>
</head>
<body>
  <main class="app">
    <header class="header"><div class="brand"><div class="brand-mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 18 6 8l6 8 6-8 3 10M4 21h16M12 3v9"/><circle cx="12" cy="3" r="1.5"/></svg></div><div><div class="brand-name">TIDELINK</div><div class="brand-sub">Flood rescue · remote boat</div></div></div><div class="sim-status"><span class="live-dot"></span>Simulation active</div></header>
    <section class="hero"><div><div class="eyebrow">Flood rescue mission · boat ↔ control room</div><h1>Flood rescue command simulator</h1><p>Navigate a remote-controlled rescue boat through flooded house corridors. Use thermal detection to locate survivors and send their GPS position to the control room.</p></div><div class="radio-config">RADIO LINK<strong>LoRa · 915 MHz · SF7</strong></div></section>

    <section class="panel architecture" aria-labelledby="diagramTitle"><div class="architecture-head"><div><div class="side-label">Reference block diagram</div><h2 id="diagramTitle">Hardware architecture · boat ↔ control room</h2></div><span class="architecture-hint">Scroll horizontally on narrow screens</span></div><div class="diagram-scroll"><div class="diagram" role="img" aria-label="SOS switch, thermal camera, ultrasonic, GPS and water sensors feed the Heltec ESP32 LoRa sensor-fusion controller. It controls boat drive and sends LoRa packets to the receiver and laptop alert display. An RF remote controller provides manual drive override."><div class="diagram-zone"><div class="diagram-zone-title">Boat · transmitter side</div><div class="diagram-boat-grid"><div class="diagram-inputs"><div class="diagram-block"><strong>SOS switch</strong><span>Manual trigger</span></div><div class="diagram-block"><strong>Thermal camera</strong><span>MLX90640</span></div><div class="diagram-block"><strong>Ultrasonic</strong><span>Obstacle sensor</span></div><div class="diagram-block"><strong>GPS module</strong><span>Position · time</span></div><div class="diagram-block"><strong>Water sensors</strong><span>pH · TDS · clarity</span></div></div><div class="diagram-link" aria-hidden="true"><span>→</span><span>→</span><span>→</span><span>→</span><span>→</span></div><div class="diagram-core"><strong>ESP32 LoRa</strong><span>Heltec V4</span><small>Sensor fusion<br>&amp; decision making</small></div><div class="diagram-link" aria-hidden="true"><span>LoRa →</span></div><div class="diagram-output"><span class="diagram-arrow" aria-hidden="true">↓</span><div class="diagram-block"><strong>Boat drive</strong><span>Motors · driver · RF receiver</span></div></div></div></div><div class="diagram-link" aria-hidden="true"><div class="signal-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 16v5m-4 0h8M8.5 12.5a5 5 0 0 1 7 0M5 9a10 10 0 0 1 14 0M1.8 5.8a14.5 14.5 0 0 1 20.4 0"/><circle cx="12" cy="18" r="1" fill="currentColor"/></svg></div><strong>LoRa radio</strong><span>Telemetry · SOS</span><span>915 MHz*</span><span>→ → →</span></div><div class="diagram-zone control-zone"><div class="diagram-zone-title">Control room · receiver side</div><div class="diagram-block"><strong>LoRa receiver</strong><span>Receives packets &amp; alerts</span></div><div class="diagram-arrow" aria-hidden="true">↓</div><div class="diagram-block"><strong>Laptop</strong><span>Alert display · event log</span></div><div class="diagram-block"><strong>RF remote controller</strong><span>Manual override</span></div></div><div class="diagram-rf-band"><div class="rf-band-boat">BOAT DRIVE · RF RX</div><div class="rf-band-arrow">← &nbsp; RF MANUAL OVERRIDE &nbsp; ←</div><div class="rf-band-control">CONTROL-ROOM REMOTE</div></div></div></div><div class="architecture-caption"><strong>Data paths:</strong> sensor readings &amp; SOS → ESP32 decision logic → LoRa alert display; RF remote → boat-drive receiver (separate control link). *Select the legal radio band for your region.</div></section>      <section class="panel mission-panel" aria-labelledby="missionTitle"><div class="mission-head"><div><div class="side-label">Live rescue exercise</div><h2 id="missionTitle">Flooded-house navigation &amp; survivor search</h2><p>Use the RF remote to steer through narrow corridors. Thermal scanning finds survivors and sends their coordinates to the rescue control room.</p></div><span class="tag" id="missionState"><span class="live-dot"></span>SEARCHING</span></div><div class="mission-layout"><div class="house-map" id="houseMap" role="img" aria-label="Top-down simulated flooded house map. Use the RF remote direction buttons to navigate the boat through walkable passages."></div><div class="mission-stats"><div class="mission-stat"><span>Boat position</span><strong id="boatPosition">Room grid 2, 6</strong></div><div class="mission-stat"><span>Thermal scan</span><strong id="thermalScanState">ACTIVE</strong></div><div class="mission-stat"><span>Survivors located</span><strong id="survivorCount">0 / 2</strong></div><div class="mission-stat"><span>Nearest target</span><strong id="nearestTarget">Scanning…</strong></div><div class="survivor-status" id="survivorStatus" aria-live="polite">No survivor detected yet. Navigate slowly through the rooms with thermal scan enabled.</div><button class="rescue-button" id="markRescued" type="button" hidden>Mark nearest survivor rescued</button><section class="remote mission-remote"><div class="remote-top"><span class="remote-title">RF remote controller · manual override</span><span class="rf-chip">RF · SEPARATE LINK</span></div><div class="remote-grid"><span class="remote-spacer">.</span><button class="remote-btn" data-command="FORWARD" type="button">↑ Forward</button><span class="remote-spacer">.</span><button class="remote-btn" data-command="LEFT" type="button">← Left</button><button class="remote-btn stop" data-command="STOP" type="button">■ Stop</button><button class="remote-btn" data-command="RIGHT" type="button">Right →</button><span class="remote-spacer">.</span><button class="remote-btn" data-command="REVERSE" type="button">↓ Reverse</button><button class="remote-btn auto" data-command="AUTO" type="button">Auto</button></div><div class="remote-note">Directional controls pilot one cell at a time through open corridors.</div></section><div class="map-legend"><span class="legend-key"><i class="legend-swatch water"></i>Flooded floor</span><span class="legend-key"><i class="legend-swatch"></i>Wall</span><span class="legend-key"><i class="legend-swatch boatkey"></i>Rescue boat</span><span class="legend-key"><i class="legend-swatch heat"></i>Thermal detection</span></div><div class="mission-disclaimer">Map and survivors are fictional simulation targets—not real buildings, people, or coordinates.</div></div></div></section>

    <section class="system-grid" aria-label="Boat and control room system simulation">
      <article class="side boat-side">
        <div class="side-title"><div><div class="side-label">Boat · transmitter side</div><h2>Flooded-house rescue boat</h2></div><span class="tag"><span class="live-dot"></span>Heltec V4</span></div>
        <div class="boat-layout">
          <div class="sensor-list">
            <section class="sensor"><div class="sensor-head"><div><div class="sensor-name">Thermal camera</div><div class="sensor-model">MLX90640 · survivor search</div></div><span class="sensor-state" id="thermalState">NORMAL</span></div><div class="slider-row"><input id="temperature" aria-label="Thermal temperature" type="range" min="18" max="90" value="31"><output class="reading" id="temperatureOut">31 °C</output></div><label class="thermal-toggle"><span>Thermal survivor scan enabled</span><span class="switch"><input id="thermalScan" type="checkbox" aria-label="Enable thermal survivor scanning" checked><span></span></span></label><button class="move-btn" id="manualDetect" type="button">◎ Simulate thermal detection in view</button></section>
            <section class="sensor"><div class="sensor-head"><div><div class="sensor-name">Flooded corridor sonar</div><div class="sensor-model">Clearance to wall or debris</div></div><span class="sensor-state" id="obstacleState">CLEAR</span></div><div class="slider-row"><input id="distance" aria-label="Obstacle distance" type="range" min="10" max="500" value="240"><output class="reading" id="distanceOut">240 cm</output></div><div class="tiny-note">Caution below 150 cm · auto stop below 70 cm</div></section>
            <section class="sensor"><div class="sensor-head"><div><div class="sensor-name">Water sensors</div><div class="sensor-model">Simulated water quality</div></div><span class="sensor-state" id="waterState">NORMAL</span></div><div class="water-grid"><div class="water-item"><label for="ph"><span>pH</span><output id="phOut">7.2</output></label><input id="ph" aria-label="Water pH" type="range" min="0" max="14" value="7.2" step="0.1"></div><div class="water-item"><label for="tds"><span>TDS ppm</span><output id="tdsOut">220</output></label><input id="tds" aria-label="Water TDS" type="range" min="0" max="1200" value="220" step="10"></div><div class="water-item"><label for="clarity"><span>Clarity %</span><output id="clarityOut">82</output></label><input id="clarity" aria-label="Water clarity" type="range" min="0" max="100" value="82"></div><div class="water-item"><label><span>Water</span><output>LIVE</output></label><div class="tiny-note">Adjust values to test alerts</div></div></div><div class="water-report" aria-live="polite"><div class="water-report-head"><span>Water quality assessment</span><strong id="waterQuality">ASSESSING</strong></div><div class="water-report-text" id="waterReportText">Adjust pH, TDS and clarity to assess the simulated sample.</div><div class="water-report-limits">Demo limits only · not a drinking-water or safety certification.</div></div></section>
          </div>
          <section class="boat-core">
            <div class="core-top"><div><div class="core-name">ESP32 LoRa</div><div class="core-sub">Sensor fusion &amp; decision</div></div><span class="core-chip">NODE 01</span></div>
            <label class="boat-id-label" for="boatId">Boat ID</label><input class="text-field" id="boatId" maxlength="20" value="BOAT-01" aria-label="Boat ID">
            <div class="gps-card"><div class="gps-card-top"><span>GPS module</span><span>NEO-6M · FIX</span></div><div class="gps-values"><label>LAT<input id="latitude" inputmode="decimal" value="37.77490" aria-label="GPS latitude"></label><label>LON<input id="longitude" inputmode="decimal" value="-122.41940" aria-label="GPS longitude"></label></div><div class="gps-time" id="gpsTime">Position time · —</div></div>
            <div class="tx-status"><div class="tx-head"><span class="tx-title">Transmitter status</span><span class="tx-chip" id="txChip">IDLE</span></div><div class="tx-indicators"><div class="tx-led" id="txLed" title="TX/RX activity LED"></div><div class="tx-buzzer" id="txBuzzer" title="Buzzer"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M11 5 6 9H2v6h4l5 4V5Z"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/></svg></div><div class="tx-msg" id="txMsg">Ready to transmit</div></div></div>
            <div class="move-btn" id="moveBoat">GPS position updates from the simulated boat route</div>
            <div class="decision"><div class="decision-head">Fused safety decision</div><div class="decision-value" id="decisionValue">ROUTE CLEAR · CRUISING</div><div class="decision-reason" id="decisionReason">All simulated sensors within configured limits.</div></div>
            <div class="drive-state"><div class="drive-head"><span class="drive-name">Boat drive · motors</span><span class="drive-mode" id="driveMode">AUTO</span></div><div class="drive-direction" id="driveDirection">CRUISING FORWARD</div><div class="drive-sub" id="driveSub">RF receiver ready · safe simulated state</div></div>
            <div class="sos-block"><button class="sos-btn" id="sosButton" type="button">! &nbsp; TRIGGER MANUAL SOS</button><div class="sos-hint">Sends emergency + Boat ID + GPS + timestamp</div></div>
          </section>
        </div>
      </article>

      <section class="radio" aria-label="LoRa radio link"><div class="radio-label">LoRa telemetry link</div><div class="radio-animation" id="radioAnimation"><span class="wave"></span><span class="wave"></span><span class="wave"></span><div class="radio-center"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 16v5m-4 0h8M8.5 12.5a5 5 0 0 1 7 0M5 9a10 10 0 0 1 14 0M1.8 5.8a14.5 14.5 0 0 1 20.4 0"/><circle cx="12" cy="18" r="1" fill="currentColor"/></svg></div></div><div class="radio-band">LoRa · 915 MHz</div><div class="radio-settings">SF7 · BW 125 kHz</div><div class="radio-count"><span id="packetCount">0</span> packets received</div></section>

      <article class="side control-side">
        <div class="side-title"><div><div class="side-label">Control room · receiver side</div><h2>Rescue control room</h2></div><span class="tag" style="color:var(--blue);border-color:#36546a;background:#14212b"><span class="live-dot" style="background:var(--blue);box-shadow:0 0 9px var(--blue)"></span>LISTENING</span></div>
        <div class="rx-alert" id="emergencyBanner"><span>! &nbsp; EMERGENCY — <span id="emergencyBoat">BOAT-01</span></span><button id="ackEmergency" type="button">Acknowledge</button></div>
        <div class="laptop" id="laptop"><div class="empty-rx" id="emptyRx">LoRa receiver listening.<br>Incoming telemetry and SOS alerts appear here.</div><div class="packet" id="packet" hidden><div class="packet-top"><div class="packet-title" id="packetTitle">INCOMING TELEMETRY</div><span class="packet-kind" id="packetKind">STATUS</span></div><div class="packet-message" id="packetMessage">—</div><div class="packet-coordinate" id="packetCoordinates">—</div><div class="packet-meta"><div class="packet-cell"><span>Boat ID</span><strong id="packetBoat">—</strong></div><div class="packet-cell"><span>GPS time</span><strong id="packetGpsTime">—</strong></div><div class="packet-cell"><span>Sensor fusion</span><strong id="packetDecision">—</strong></div><div class="packet-cell"><span>RF drive</span><strong id="packetDrive">—</strong></div><div class="packet-cell packet-water"><span>Water quality report · pH / TDS / clarity</span><strong id="packetWater">—</strong></div></div><div class="rx-bottom"><span id="packetSequence">PACKET —</span><span id="packetRssi">— dBm</span><span id="packetReceived">—</span></div></div></div>
        <button class="send-button" id="sendTelemetry" type="button" style="width:100%;margin-top:8px;border:1px solid #79b7e8;border-radius:8px;background:linear-gradient(110deg,#b6ddfb,#85c5f4);color:#102235;padding:9px;font-size:10px;font-weight:800">Transmit status telemetry</button><button class="send-button" id="sendWaterReport" type="button" style="width:100%;margin-top:7px;border:1px solid #5a8d75;border-radius:8px;background:#193326;color:#bff0cf;padding:9px;font-size:10px;font-weight:800">Send water quality report</button>
      </article>
    </section>

    <section class="panel alert-panel"><div class="panel-head"><h2>Control-room event log</h2><button class="clear-btn" id="clearLog" type="button">Clear events</button></div><div class="event-log" id="eventLog"><div class="event-row" id="emptyEvent"><span class="event-icon">i</span><div class="event-main"><div class="event-title">System ready</div><div class="event-detail">Adjust simulated sensors, transmit telemetry, or trigger SOS.</div></div></div></div></section>
    <div class="notice"><strong>Simulation only.</strong> Thermal detections, flooded-house navigation, sensors, LoRa packets and RF controls are simulated. Thermal cameras detect heat signatures, not human identity; real survivor confirmation requires trained responders and tested sensor fusion. Demo map and detection ranges are fictional. Never use this page for real navigation or emergency response.</div>
  </main>
  <div class="toast" id="toast" role="status" aria-live="polite"></div>
  <script>
  (()=>{
    const $=id=>document.getElementById(id);let packets=0,toastTimer,sendTimer,moveStep=0,drive="AUTO",emergency=false,previousHazards="",sendBusy=false;
    const now=()=>new Date(),timeText=d=>d.toLocaleString([], {year:"numeric",month:"short",day:"2-digit",hour:"2-digit",minute:"2-digit",second:"2-digit"});
    const position=()=>({lat:Number($("latitude").value),lon:Number($("longitude").value)});
    const mapWidth=12,mapHeight=7,boat={x:1,y:5},survivors=[{x:2,y:3,id:"SURVIVOR-01",found:false,rescued:false},{x:10,y:5,id:"SURVIVOR-02",found:false,rescued:false}],walls=new Set();
    for(let y=0;y<mapHeight;y++)for(let x=0;x<mapWidth;x++)if(x===0||y===0||x===mapWidth-1||y===mapHeight-1)walls.add(`${x},${y}`);
    for(const x of [3,6,9])for(const y of [1,2,4,5])walls.add(`${x},${y}`);
    function renderMap(){const map=$("houseMap");map.replaceChildren();for(let y=0;y<mapHeight;y++)for(let x=0;x<mapWidth;x++){const cell=document.createElement("div");cell.className="map-cell";const key=`${x},${y}`,target=survivors.find(s=>s.x===x&&s.y===y);if(walls.has(key))cell.classList.add("wall");else if(boat.x===x&&boat.y===y){cell.classList.add("boat");cell.innerHTML='<span class="cell-glyph">▲</span>';}else if(target?.rescued){cell.classList.add("rescued");cell.innerHTML='<span class="cell-glyph">✓</span>';cell.title=`${target.id} rescued`;}else if(target?.found){cell.classList.add("survivor");cell.innerHTML='<span class="cell-glyph">♙</span>';cell.title=`${target.id} location found`;}else if(target&&$("thermalScan").checked&&Math.abs(boat.x-x)+Math.abs(boat.y-y)<=1){cell.classList.add("detected");cell.innerHTML='<span class="cell-glyph">♨</span>';}else if(x===10&&y===1){cell.classList.add("exit");cell.textContent="ENTRY";}else{cell.classList.add("floor");}map.append(cell);}}
    function updateMission(){const found=survivors.filter(s=>s.found).length,rescued=survivors.filter(s=>s.rescued).length;$("boatPosition").textContent=`Room grid ${boat.x}, ${boat.y}`;$("thermalScanState").textContent=$("thermalScan").checked?"ACTIVE":"OFF";$("survivorCount").textContent=`${rescued} / ${survivors.length}`;const remaining=survivors.filter(s=>!s.rescued);$("nearestTarget").textContent=remaining.length?`${Math.min(...remaining.map(s=>Math.abs(boat.x-s.x)+Math.abs(boat.y-s.y)))} cells`:"All located";$("missionState").lastChild.textContent=rescued===survivors.length?"MISSION COMPLETE":found?"SURVIVOR FOUND":"SEARCHING";$("survivorStatus").textContent=rescued===survivors.length?"All simulated survivors rescued. Exercise complete.":found>rescued?`${found-rescued} survivor location${found-rescued===1?"":"s"} found. Navigate to a marked survivor and select rescue.`:"No survivor detected yet. Navigate slowly through the flooded rooms with thermal scan enabled.";const target=survivors.find(s=>s.found&&!s.rescued&&Math.abs(boat.x-s.x)+Math.abs(boat.y-s.y)<=1);$("markRescued").hidden=!target;$("markRescued").textContent=target?`Mark ${target.id} rescued`:"Mark nearest survivor rescued";renderMap();}
    function scanSurvivors(){if(!$("thermalScan").checked)return;const found=survivors.filter(s=>!s.found&&Math.abs(boat.x-s.x)+Math.abs(boat.y-s.y)<=1);for(const s of found){s.found=true;const stamp=timeText(now());addEvent(`Thermal survivor located · ${s.id}`,`Heat signature in flooded house · ${$("boatId").value.trim()} · ${position().lat.toFixed(5)}, ${position().lon.toFixed(5)} · ${stamp}`,"danger",stamp);transmit("SURVIVOR LOCATED",`THERMAL DETECTION · ${s.id} · ${position().lat.toFixed(5)}, ${position().lon.toFixed(5)} · ${stamp}`,false);}updateMission();}
    function moveBoat(command){const delta=({FORWARD:[0,-1],REVERSE:[0,1],LEFT:[-1,0],RIGHT:[1,0]})[command];if(!delta)return false;const x=boat.x+delta[0],y=boat.y+delta[1];if(command==="FORWARD"&&Number($("distance").value)<70){toast("Forward sonar stop — obstacle too close.");addEvent("Navigation safety stop",`Forward blocked at ${$("distance").value} cm clearance.`,"danger");return false;}if(walls.has(`${x},${y}`)){toast("Wall detected — choose another corridor.");addEvent("Navigation blocked","Sonar/map indicates a wall. Boat held in the corridor.","warning");return false;}boat.x=x;boat.y=y;const p=position(),lat=p.lat-delta[1]*0.00004,lon=p.lon+delta[0]*0.00004;$("latitude").value=lat.toFixed(5);$("longitude").value=lon.toFixed(5);$("gpsTime").textContent=`Position time · ${timeText(now())}`;addEvent("Rescue boat moved",`${command} · grid ${boat.x}, ${boat.y} · ${lat.toFixed(5)}, ${lon.toFixed(5)}`);updateMission();updateSensors();scanSurvivors();return true;}
    function toast(message){const t=$("toast");t.textContent=message;t.classList.add("visible");clearTimeout(toastTimer);toastTimer=setTimeout(()=>t.classList.remove("visible"),2200)}
    function addEvent(title,detail,level="normal",stamp=timeText(now())){const empty=$("emptyEvent");if(empty)empty.remove();const row=document.createElement("div");row.className="event-row";const icon=document.createElement("span");icon.className=`event-icon${level==="danger"?" danger":level==="warning"?" warning":""}`;icon.textContent=level==="danger"?"!":level==="warning"?"△":"↗";const main=document.createElement("div");main.className="event-main";const heading=document.createElement("div");heading.className="event-title";heading.textContent=title;const text=document.createElement("div");text.className="event-detail";text.textContent=detail;const time=document.createElement("span");time.className="event-time";time.textContent=stamp;main.append(heading,text);row.append(icon,main,time);$("eventLog").prepend(row)}
    function sensorDecision(){const distance=Number($("distance").value),temp=Number($("temperature").value),person=$("thermalScan").checked&&survivors.some(s=>!s.rescued&&Math.abs(boat.x-s.x)+Math.abs(boat.y-s.y)<=1),ph=Number($("ph").value),tds=Number($("tds").value),clarity=Number($("clarity").value);const waterFlags=[];if(ph<6.5||ph>8.5)waterFlags.push("pH outside demo range");if(tds>500)waterFlags.push("TDS above demo threshold");if(clarity<50)waterFlags.push("clarity below demo threshold");const hazards=[];if(distance<70)hazards.push("OBSTACLE_STOP");else if(distance<150)hazards.push("OBSTACLE_NEAR");if(person)hazards.push("PERSON_DETECTED");if(temp>=65)hazards.push("HIGH_TEMPERATURE");if(ph<6.5||ph>8.5)hazards.push("WATER_PH");if(tds>500)hazards.push("WATER_TDS");if(clarity<50)hazards.push("WATER_CLARITY");return{distance,temp,person,ph,tds,clarity,waterFlags,hazards}}
    function updateSensors(){const d=sensorDecision();$("temperatureOut").textContent=`${d.temp} °C`;$("distanceOut").textContent=`${d.distance} cm`;$("phOut").textContent=d.ph.toFixed(1);$("tdsOut").textContent=String(d.tds);$("clarityOut").textContent=`${d.clarity}%`;
      const thermal=$("thermalState");thermal.textContent=d.person?"PERSON DETECTED":d.temp>=65?"HOT":"NORMAL";thermal.className=`sensor-state${d.person||d.temp>=65?" danger":""}`;
      const obstacle=$("obstacleState");obstacle.textContent=d.distance<70?"STOP":d.distance<150?"NEAR":"CLEAR";obstacle.className=`sensor-state${d.distance<70?" danger":d.distance<150?" warn":""}`;
      const water=$("waterState"),waterAlarm=d.waterFlags.length>0;water.textContent=waterAlarm?"CHECK WATER":"WITHIN DEMO RANGE";water.className=`sensor-state${waterAlarm?" warn":""}`;const quality=$("waterQuality"),qualityText=$("waterReportText");quality.textContent=d.waterFlags.length?"OUTSIDE DEMO RANGE":"WITHIN DEMO RANGE";quality.className=d.waterFlags.length?"warn":"";qualityText.textContent=`pH ${d.ph.toFixed(1)} · TDS ${d.tds} ppm · clarity ${d.clarity}%${d.waterFlags.length?` · Check: ${d.waterFlags.join(", ")}`:" · No configured screening flags."}`;
      const value=$("decisionValue"),reason=$("decisionReason");if(emergency){value.textContent="SOS ACTIVE · MOTORS STOPPED";value.className="decision-value danger";reason.textContent="Emergency latched. Acknowledge at control room before resuming drive.";if(drive!=="STOP")setDrive("STOP",false)}else if(d.distance<70){value.textContent="OBSTACLE · AUTO STOP";value.className="decision-value danger";reason.textContent=`Obstacle at ${d.distance} cm; motors stop in auto mode.`;if(drive==="AUTO"){drive="STOP";setDrive("STOP",false)}}else if(d.hazards.length){value.textContent="SAFETY ALERT · REVIEW";value.className="decision-value warn";reason.textContent=describeHazards(d.hazards);if(drive==="AUTO"){drive=d.distance<150?"SLOW":"CRUISING";setDrive(drive,false)}}else{value.textContent="ROUTE CLEAR · CRUISING";value.className="decision-value";reason.textContent="All simulated sensors within configured limits.";if(drive==="SLOW"||drive==="CRUISING") {drive="AUTO";setDrive("AUTO",false)}}
      const signature=d.hazards.join("|");if(signature!==previousHazards){const had=previousHazards.split("|").filter(Boolean),fresh=d.hazards.filter(h=>!had.includes(h));previousHazards=signature;if(fresh.length){clearTimeout(sendTimer);sendTimer=setTimeout(()=>{const current=sensorDecision();const currentFresh=current.hazards.filter(h=>!had.includes(h));if(currentFresh.length){addEvent("Sensor-fusion alert",describeHazards(currentFresh),currentFresh.includes("OBSTACLE_STOP")?"danger":"warning");transmit(currentFresh.includes("OBSTACLE_STOP")?"OBSTACLE STOP ALERT":"SENSOR ALERT",describeHazards(currentFresh),false)}},550)}}}
    function describeHazards(hazards){return hazards.map(h=>({OBSTACLE_STOP:`Obstacle close (${ $("distance").value } cm)`,OBSTACLE_NEAR:`Obstacle nearby (${ $("distance").value } cm)`,PERSON_DETECTED:"Thermal camera detected a person in view",HIGH_TEMPERATURE:`Thermal reading ${$("temperature").value} °C`,WATER_PH:`Water pH ${Number($("ph").value).toFixed(1)} outside demo range`,WATER_TDS:`TDS ${$("tds").value} ppm above demo threshold`,WATER_CLARITY:`Water clarity ${$("clarity").value}% below demo threshold`})[h]||h).join(" · ")}
    function setDrive(command,log=true){if(log&&["FORWARD","REVERSE","LEFT","RIGHT"].includes(command)&&!moveBoat(command))return;drive=command;$("driveMode").textContent=command==="AUTO"?"AUTO":"MANUAL";$("driveDirection").textContent=({AUTO:"CRUISING FORWARD",CRUISING:"CRUISING FORWARD",SLOW:"SLOW · CAUTION",STOP:"MOTORS STOPPED",FORWARD:"FORWARD",LEFT:"TURNING LEFT",RIGHT:"TURNING RIGHT",REVERSE:"REVERSE"})[command]||command;$("driveSub").textContent=command==="AUTO"?"RF receiver ready · safe simulated state":`RF remote command · ${command.toLowerCase()}`;document.querySelectorAll(".remote-btn").forEach(b=>b.classList.toggle("selected",b.dataset.command===command));if(log)addEvent("RF manual override",`Boat drive command: ${command}. RF link is independent of LoRa telemetry.`,command==="STOP"?"warning":"normal");}
    function setTxStatus(state,message){const led=$("txLed"),chip=$("txChip"),buzz=$("txBuzzer"),msg=$("txMsg"),box=document.querySelector(".tx-status");if(!led)return;led.className="tx-led";chip.className="tx-chip";buzz.classList.remove("active");if(box)box.style.borderColor="#345442";if(state==="tx"){led.classList.add("tx");chip.classList.add("tx");chip.textContent="TX";buzz.classList.add("active");if(box)box.style.borderColor="#6b5a33";msg.textContent=message||"Transmitting...";}else if(state==="rx"){led.classList.add("rx");chip.classList.add("rx");chip.textContent="RX ACK";buzz.classList.add("active");if(box){box.style.borderColor="#3a5a6b";box.style.boxShadow="0 0 12px #9bcfff33";}msg.textContent=message||"Message received by receiver";}else{chip.textContent="IDLE";buzz.classList.remove("active");if(box){box.style.boxShadow="none";}msg.textContent=message||"Ready to transmit";}}
    function transmit(kind="STATUS TELEMETRY",message=null,isSos=false){if(sendBusy)return;const{lat,lon}=position(),boat=$("boatId").value.trim();if(!Number.isFinite(lat)||lat< -90||lat>90||!Number.isFinite(lon)||lon< -180||lon>180){toast("Enter a valid GPS latitude and longitude.");return}if(!boat){toast("Enter a boat ID before transmitting.");$("boatId").focus();return}sendBusy=true;const sentAt=now(),stamp=timeText(sentAt),d=sensorDecision(),waterSummary=`${d.waterFlags.length?"CHECK SAMPLE":"WITHIN DEMO RANGE"} · pH ${d.ph.toFixed(1)} · TDS ${d.tds} ppm · clarity ${d.clarity}%`,payload=message||`GPS fix · ${d.distance} cm clearance · ${waterSummary}`;$("radioAnimation").classList.add("active");$("sendTelemetry").disabled=true;$("sendWaterReport").disabled=true;$("sosButton").disabled=true;setTxStatus("tx",isSos?"Sending SOS...":"Transmitting...");toast(isSos?`SOS transmitting from ${boat}…`:"LoRa packet transmitting…");
      setTimeout(()=>{packets++;$("emptyRx").hidden=true;$("packet").hidden=false;$("packetTitle").textContent=isSos?"EMERGENCY ALERT RECEIVED":"INCOMING TELEMETRY";$("packetKind").textContent=isSos?"SOS · EMERGENCY":kind;$("packetKind").className=`packet-kind${isSos?" sos":""}`;$("packetMessage").textContent=payload;$("packetCoordinates").textContent=`${lat.toFixed(5)}°, ${lon.toFixed(5)}°`;$("packetBoat").textContent=boat;$("packetGpsTime").textContent=stamp;$("packetDecision").textContent=$("decisionValue").textContent;$("packetDrive").textContent=$("driveDirection").textContent;$("packetWater").textContent=waterSummary;$("packetSequence").textContent=`PACKET ${String(packets).padStart(3,"0")}`;$("packetRssi").textContent=`-${70+Math.floor(Math.random()*20)} dBm`;$("packetReceived").textContent=`RX ${timeText(now())}`;$("packetCount").textContent=packets;if(isSos){$("emergencyBanner").classList.add("show");$("emergencyBoat").textContent=boat;}addEvent(isSos?`SOS EMERGENCY · ${boat}`:`${kind} · ${boat}`,`${payload} · ${lat.toFixed(5)}, ${lon.toFixed(5)} · GPS ${stamp}`,isSos?"danger":kind.includes("ALERT")?"warning":"normal",timeText(now()));$("radioAnimation").classList.remove("active");$("sendTelemetry").disabled=false;$("sendWaterReport").disabled=false;$("sosButton").disabled=false;sendBusy=false;setTxStatus("rx",isSos?"SOS received by control room":"ACK: Message received");setTimeout(()=>setTxStatus("idle","Ready to transmit"),2000);toast(isSos?`Emergency packet received for ${boat}.`:"LoRa packet received by control room.");},800)}
    $("sosButton").addEventListener("click",()=>{emergency=true;setDrive("STOP");updateSensors();transmit("SOS","EMERGENCY · Manual SOS switch activated",true);});
    $("sendTelemetry").addEventListener("click",()=>transmit("STATUS TELEMETRY"));
    $("sendWaterReport").addEventListener("click",()=>{const d=sensorDecision(),summary=`${d.waterFlags.length?"WATER QUALITY CHECK REQUIRED":"WATER QUALITY SCREENING · WITHIN DEMO RANGE"} · pH ${d.ph.toFixed(1)} · TDS ${d.tds} ppm · clarity ${d.clarity}% · ${timeText(now())}`;transmit("WATER QUALITY REPORT",summary,false)});
    $("ackEmergency").addEventListener("click",()=>{$("emergencyBanner").classList.remove("show");emergency=false;updateSensors();addEvent("SOS acknowledged", `Control room acknowledged emergency from ${$("emergencyBoat").textContent}. Boat remains stopped until a drive command is issued.`, "warning"); if(typeof setTxStatus==="function"){setTxStatus("rx","SOS ACKNOWLEDGED by Control Room");setTimeout(()=>setTxStatus("idle","Ready to transmit"),2500);} toast("SOS acknowledged; boat remains stopped.")});
    $("ackEmergency").addEventListener("click",()=>{$("emergencyBanner").classList.remove("show");emergency=false;updateSensors();addEvent("SOS acknowledged", `Control room acknowledged emergency from ${$("emergencyBoat").textContent}. Boat remains stopped until a drive command is issued.`, "warning"); if(typeof setTxStatus==="function"){setTxStatus("rx","SOS ACKNOWLEDGED by Control Room");setTimeout(()=>setTxStatus("idle","Ready to transmit"),2500);} toast("SOS acknowledged; boat remains stopped.")});
    document.querySelectorAll(".remote-btn").forEach(button=>button.addEventListener("click",()=>{let command=button.dataset.command;if(emergency&&command!=="STOP"){toast("Acknowledge the SOS at control room before changing the drive.");setDrive("STOP",false);return}if(command==="AUTO"){const d=sensorDecision();if(d.distance<70){toast("Auto mode keeps motors stopped: obstacle too close.");setDrive("STOP");return}setDrive(d.distance<150?"SLOW":"AUTO");return}if(command==="FORWARD"&&Number($("distance").value)<70){setDrive("STOP");toast("Forward blocked by obstacle safety interlock.");return}setDrive(command)}));
    ["temperature","distance","thermalScan","ph","tds","clarity"].forEach(id=>$(id).addEventListener("input",()=>{updateSensors();if(id==="thermalScan"){updateMission();scanSurvivors();}}));
    $("markRescued").addEventListener("click",()=>{const target=survivors.find(s=>s.found&&!s.rescued&&Math.abs(boat.x-s.x)+Math.abs(boat.y-s.y)<=1);if(!target)return;target.rescued=true;const stamp=timeText(now());addEvent(`Survivor assisted · ${target.id}`,`Simulated rescue recorded at ${position().lat.toFixed(5)}, ${position().lon.toFixed(5)} · ${stamp}`,"normal",stamp);transmit("RESCUE UPDATE",`SURVIVOR ASSISTED · ${target.id} · ${position().lat.toFixed(5)}, ${position().lon.toFixed(5)} · ${stamp}`,false);updateMission()});
    $("latitude").addEventListener("change",()=>$("gpsTime").textContent=`Position time · ${timeText(now())}`);$("longitude").addEventListener("change",()=>$("gpsTime").textContent=`Position time · ${timeText(now())}`);
    $("clearLog").addEventListener("click",()=>{$("eventLog").replaceChildren();addEvent("Event log cleared","New sensor alerts, LoRa packets and RF commands will appear here.")});
    $("gpsTime").textContent=`Position time · ${timeText(now())}`;setTxStatus("idle","Ready to transmit");$("manualDetect").addEventListener("click",()=>{const target=survivors.filter(s=>!s.found&&!s.rescued).sort((a,b)=>(Math.abs(boat.x-a.x)+Math.abs(boat.y-a.y))-(Math.abs(boat.x-b.x)+Math.abs(boat.y-b.y)))[0];if(!target){toast("All simulated survivors are already located.");return}target.found=true;const stamp=timeText(now());addEvent(`Thermal survivor located · ${target.id}`,`Manual thermal sweep · ${$("boatId").value.trim()} · ${position().lat.toFixed(5)}, ${position().lon.toFixed(5)} · ${stamp}`,"danger",stamp);transmit("SURVIVOR LOCATED",`THERMAL DETECTION · ${target.id} · ${position().lat.toFixed(5)}, ${position().lon.toFixed(5)} · ${stamp}`,false);updateMission()});$("thermalScan").addEventListener("change",()=>{updateSensors();updateMission();scanSurvivors()});updateMission();updateSensors();scanSurvivors();
  })();
  </script>
